# Copy to .env and fill in. Every setting can also be passed as an environment variable.

# Where the data lives
TICKWELL_DATABASE_URL=sqlite:///./tickwell.db

# Extractor: "claude" (cloud, needs an API key), "local" (open model via Ollama, nothing
# leaves the machine) or "heuristic" (offline, simple order lines only)
TICKWELL_EXTRACTOR=claude
ANTHROPIC_API_KEY=
TICKWELL_ANTHROPIC_MODEL=claude-sonnet-5-5

# Local model (only when TICKWELL_EXTRACTOR=local). Pull a model first: ollama pull <model>
TICKWELL_OLLAMA_BASE_URL=http://localhost:11434
TICKWELL_OLLAMA_MODEL=
# Context window in tokens. Ollama's default is small and silently cuts long prompts.
TICKWELL_OLLAMA_NUM_CTX=16384
TICKWELL_OLLAMA_TIMEOUT=300

# true = refuse anything that would send order data outside this machine or local network
TICKWELL_LOCAL_ONLY=false

# Mail source: "folder" (reads .eml files, good for demos), "imap" or "graph" (Microsoft 365)
TICKWELL_MAIL_SOURCE=folder
TICKWELL_INBOX_DIR=data/sample/emails

# IMAP (only when TICKWELL_MAIL_SOURCE=imap)
TICKWELL_IMAP_HOST=
TICKWELL_IMAP_USER=
TICKWELL_IMAP_PASSWORD=
TICKWELL_IMAP_FOLDER=INBOX

# Microsoft 365 via Graph (only when TICKWELL_MAIL_SOURCE=graph)
TICKWELL_GRAPH_TENANT_ID=
TICKWELL_GRAPH_CLIENT_ID=
TICKWELL_GRAPH_CLIENT_SECRET=
TICKWELL_GRAPH_MAILBOX=orders@example.com

# ERP target: "csv" (writes import files) or "exact" (Exact Online API, skeleton)
TICKWELL_ERP=csv
TICKWELL_EXPORT_DIR=exports
TICKWELL_EXACT_BASE_URL=https://start.exactonline.nl
TICKWELL_EXACT_DIVISION=
TICKWELL_EXACT_ACCESS_TOKEN=

# Worker poll interval in seconds
TICKWELL_POLL_SECONDS=60

# Protect the review screen with HTTP Basic auth (strongly recommended outside localhost)
TICKWELL_UI_USER=
TICKWELL_UI_PASSWORD=
