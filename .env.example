# Copy to .env and fill in. Every setting can also be passed as an environment variable.

# Where the data lives
ORDERDESK_DATABASE_URL=sqlite:///./orderdesk.db

# Extractor: "claude" (needs an API key) or "heuristic" (offline, simple order lines only)
ORDERDESK_EXTRACTOR=claude
ANTHROPIC_API_KEY=
ORDERDESK_ANTHROPIC_MODEL=claude-sonnet-5-5

# Mail source: "folder" (reads .eml files, good for demos), "imap" or "graph" (Microsoft 365)
ORDERDESK_MAIL_SOURCE=folder
ORDERDESK_INBOX_DIR=data/sample/emails

# IMAP (only when ORDERDESK_MAIL_SOURCE=imap)
ORDERDESK_IMAP_HOST=
ORDERDESK_IMAP_USER=
ORDERDESK_IMAP_PASSWORD=
ORDERDESK_IMAP_FOLDER=INBOX

# Microsoft 365 via Graph (only when ORDERDESK_MAIL_SOURCE=graph)
ORDERDESK_GRAPH_TENANT_ID=
ORDERDESK_GRAPH_CLIENT_ID=
ORDERDESK_GRAPH_CLIENT_SECRET=
ORDERDESK_GRAPH_MAILBOX=orders@example.com

# ERP target: "csv" (writes import files) or "exact" (Exact Online API, skeleton)
ORDERDESK_ERP=csv
ORDERDESK_EXPORT_DIR=exports
ORDERDESK_EXACT_BASE_URL=https://start.exactonline.nl
ORDERDESK_EXACT_DIVISION=
ORDERDESK_EXACT_ACCESS_TOKEN=

# Worker poll interval in seconds
ORDERDESK_POLL_SECONDS=60

# Protect the review screen with HTTP Basic auth (strongly recommended outside localhost)
ORDERDESK_UI_USER=
ORDERDESK_UI_PASSWORD=
